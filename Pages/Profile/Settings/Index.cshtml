@page
@model GymTracker.Pages.Profile.Settings.IndexModel
@{
    ViewData["Title"] = "Mi perfil";
}

<h2 class="mb-4">⚙️ Configuración de entrenamiento</h2>

<div class="row g-3">

    <div class="col-md-6">
        <a asp-page="/Profile/Settings/Routine/Index"
           class="card text-decoration-none shadow-sm h-100">
            <div class="card-body">
                <h5>📋 Rutina semanal</h5>
                <p class="text-muted mb-0">
                    Configura ejercicios, series y repeticiones
                </p>
            </div>
        </a>
    </div>

    <div class="col-md-6">
        <a asp-page="/Profile/Settings/WorkoutDays/Index"
           class="card text-decoration-none shadow-sm h-100">
            <div class="card-body">
                <h5>📅 Días de entrenamiento</h5>
                <p class="text-muted mb-0">
                    Activa o desactiva los días que entrenas
                </p>
            </div>
        </a>
    </div>

</div>
