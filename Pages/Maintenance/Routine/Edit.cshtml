@page "{id:int}"
@model GymTracker.Pages.Maintenance.Routine.EditModel

@{
    ViewData["Title"] = "Editar Rutina";
}


<h2>
    Configurar @Utils.Utilities.GetDayNameInSpanishCapitalized(Model.Day!.DayOfWeek)
</h2>

<br />

<!-- ================= MUSCULOS ================= -->

@if (Model.Muscles.Any())
{
    <h4>Áreas a trabajar</h4>
    <hr />
    <div class="mb-3">
        @foreach (var m in Model.Muscles)
        {
            <span class="badge bg-secondary me-1">
                @m
            </span>
        }
    </div>
}

<br />

<!-- ================= EJERCICIOS DE FUERZA ================= -->
<h4>Ejercicios de fuerza</h4>

<form method="post" asp-page-handler="AddExercise" asp-route-id="@Model.Day.Id" class="row g-2 mb-3">
    <div class="col-md-4">
        <select asp-for="ExerciseId" class="form-select">
            <option value="">-- Ejercicio --</option>
            @foreach (var e in Model.StrengthExercises)
            {
                <option value="@e.Id">@e.Name</option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <input asp-for="PlannedSets" class="form-control" placeholder="Series" />
    </div>

    <div class="col-md-2">
        <input asp-for="PlannedReps" class="form-control" placeholder="Reps" />
    </div>

    <div class="col-md-2">
        <input asp-for="PlannedDuration" class="form-control" placeholder="Duración (seg)" />
    </div>

    <div class="col-md-2">
        <button class="btn btn-primary">Agregar</button>
    </div>
</form>

<br />
<table class="table table-sm">
    <thead>
        <tr>
            <th>Ejercicio</th>
            <th>Series</th>
            <th>Reps</th>
            <th>Duración (seg)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model.StrengthExercisesInDay)
        {
            <tr>
                <td>@e.Exercise.Name</td>
                <td>@e.PlannedSets</td>
                <td>@(e.PlannedReps.HasValue ? e.PlannedReps.ToString() : "-")</td>
                <td>@(e.PlannedDurationSeconds.HasValue ? e.PlannedDurationSeconds.ToString() : "-")</td>
                <td class="text-end">
                    <form method="post" asp-page-handler="RemoveExercise"
                          asp-route-id="@Model.Day.Id"
                          asp-route-exId="@e.Id">
                        <button class="btn btn-sm btn-outline-danger">Quitar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<br />

<!-- ================= CARDIO ================= -->
<h4>Cardio</h4>

@if (Model.CardioExercisesInDay.Any())
{
    <ul class="list-group mb-3">
        @foreach (var c in Model.CardioExercisesInDay)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>
                    @c.Exercise.Name
                    @if (c.PlannedDurationSeconds.HasValue)
                    {
                        <span class="text-muted small">
                            (@(c.PlannedDurationSeconds.Value / 60) min)
                        </span>
                    }
                </span>
                <form method="post" asp-page-handler="RemoveCardio"
                      asp-route-id="@Model.Day.Id"
                      asp-route-exId="@c.Id">
                    <button class="btn btn-sm btn-outline-danger">Quitar</button>
                </form>
            </li>
        }
    </ul>
}
else
{
    <p class="text-muted">No hay cardio asignado para este día.</p>
}

<form method="post" asp-page-handler="AddCardio" asp-route-id="@Model.Day.Id" class="row g-2">
    <div class="col-md-4">
        <select asp-for="CardioExerciseId" class="form-select">
            <option value="">-- Seleccionar cardio --</option>
            @foreach (var c in Model.CardioExercises)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <input asp-for="PlannedDuration" class="form-control" placeholder="Duración (seg)" />
    </div>

    <div class="col-md-2">
        <button class="btn btn-primary">Agregar Cardio</button>
    </div>
</form>

<br />

<a asp-page="Index" class="btn btn-outline-secondary">
    ← Volver
</a>
