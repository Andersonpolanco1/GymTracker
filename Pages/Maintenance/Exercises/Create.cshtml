@page
@model GymTracker.Pages.Maintenance.Exercises.CreateModel
@using GymTracker.Enums

@{
    ViewData["Title"] = "Nuevo Ejercicio";
}


<h2 class="mb-4">Nuevo ejercicio</h2>

<form method="post" class="card shadow-sm p-4">

    <div class="mb-3">
        <label asp-for="Exercise.Name" class="form-label"></label>
        <input asp-for="Exercise.Name" class="form-control" />
        <span asp-validation-for="Exercise.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Exercise.Type" class="form-label"></label>
        <select asp-for="Exercise.Type"
                class="form-select"
                asp-items="Html.GetEnumSelectList<ExerciseType>()"
                id="exerciseType">
            <option value="">Seleccione...</option>
        </select>
        <span asp-validation-for="Exercise.Type" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Exercise.MuscleId" class="form-label"></label>
        <select asp-for="Exercise.MuscleId"
                class="form-select"
                asp-items="Model.Muscles"
                id="muscleSelect">
            <option value="">— No aplica —</option>
        </select>
        <span asp-validation-for="Exercise.MuscleId" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <a asp-page="Index" class="btn btn-outline-secondary">Volver</a>
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const typeSelect = document.getElementById("exerciseType");
            const muscleSelect = document.getElementById("muscleSelect");

            function toggleMuscle() {
                const isCardio = typeSelect.value === "2"; // Cardio = 2
                muscleSelect.disabled = isCardio;
                if (isCardio) muscleSelect.value = "";
            }

            toggleMuscle();
            typeSelect.addEventListener("change", toggleMuscle);
        });
    </script>
}

