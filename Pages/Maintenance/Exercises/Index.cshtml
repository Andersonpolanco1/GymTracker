@page
@model GymTracker.Pages.Maintenance.Exercises.IndexModel

<h2 class="mb-4">Ejercicios</h2>

<div class="mb-3 d-flex justify-content-between align-items-center">
    <span class="text-muted">
        Total: @Model.Exercises.Count ejercicios
    </span>

    <a asp-page="Create" class="btn btn-primary">
        + Nuevo ejercicio
    </a>
</div>

<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Músculo</th>
            <th>Tipo</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var exercise in Model.Exercises)
        {
            <tr>
                <td>@exercise.Name</td>

                <td>
                    @if (exercise.Muscle != null)
                    {
                        @exercise.Muscle.Name
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>

                <td>
                    @if (exercise.Type == Enums.ExerciseType.Strength)
                    {
                        <span class="badge bg-primary">Fuerza</span>
                    }
                    else if (exercise.Type == Enums.ExerciseType.Cardio)
                    {
                        <span class="badge bg-success">Cardio</span>
                    }

                </td>

                <td class="text-end">
                    <a asp-page="Edit" asp-route-id="@exercise.Id"
                       class="btn btn-sm btn-outline-warning">
                        Editar
                    </a>

                    <a asp-page="Delete" asp-route-id="@exercise.Id"
                       class="btn btn-sm btn-outline-danger ms-1">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Exercises.Any())
{
    <div class="alert alert-info mt-4">
        No hay ejercicios registrados.
    </div>
}
