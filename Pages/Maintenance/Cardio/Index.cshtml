@page
@model GymTracker.Pages.Maintenance.Cardio.IndexModel
@{
    ViewData["Title"] = "Mantenimiento de Cardio";
}

<h2 class="mb-3">Mantenimiento de Cardio</h2>

<a class="btn btn-primary mb-3" asp-page="./Create">Agregar Cardio</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Nombre del Ejercicio</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.CardioExercises.Any())
        {
            @foreach (var c in Model.CardioExercises)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Name</td>
                    <td>
                        <a class="btn btn-sm btn-warning" asp-page="./Edit" asp-route-id="@c.Id">Editar</a>
                        <a class="btn btn-sm btn-danger" asp-page="./Delete" asp-route-id="@c.Id">Eliminar</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center text-muted">No hay ejercicios de cardio registrados</td>
            </tr>
        }
    </tbody>
</table>
