@page
@model GymTracker.Pages.Maintenance.Muscles.CreateModel

<h2 class="mb-4">Nuevo músculo</h2>

<form method="post" class="card p-4 shadow-sm" style="max-width: 500px;">

    <div class="mb-3">
        <label asp-for="Muscle.Name" class="form-label"></label>
        <input asp-for="Muscle.Name" class="form-control" />
        <span asp-validation-for="Muscle.Name" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">
            Guardar
        </button>

        <a asp-page="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
