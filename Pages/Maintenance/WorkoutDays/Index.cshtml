@page
@model GymTracker.Pages.Maintenance.WorkoutDays.IndexModel
@{
    ViewData["Title"] = "Rutina semanal";
}

<h2 class="mb-4">Rutina semanal</h2>

<form method="post">
    <div class="row">
        @foreach (var day in Model.Days)
        {
            <div class="col-md-4 mb-3">
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="SelectedDays"
                           value="@day.Day"
                           checked="@day.IsSelected" />

                    <label class="form-check-label">
                        @day.Day
                    </label>
                </div>
            </div>
        }
    </div>

    <button class="btn btn-primary mt-3">
        Guardar rutina
    </button>
</form>
