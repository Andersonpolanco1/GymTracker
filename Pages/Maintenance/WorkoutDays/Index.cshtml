@page
@model GymTracker.Pages.Maintenance.WorkoutDays.IndexModel
@{
    ViewData["Title"] = "Dias de entrenamiento";
}

<h2 class="mb-4">Días de entrenamiento</h2>

<div class="mb-4">
    <a asp-page="/Maintenance/Routine/Index"
       class="link-primary text-decoration-none">
        ⚙️ Agregar/eliminar ejercicios a dias
    </a>
</div>

<div class="row">
    @foreach (var day in Model.Days)
    {
        <div class="col-md-4 mb-3">
            <form method="post" asp-page-handler="Toggle">
                <input type="hidden" name="Day" value="@day.Day" />

                <button type="submit"
                        class="btn w-100 @(day.IsSelected ? "btn-success" : "btn-outline-secondary")">
                    @Utils.Utilities.GetDayNameInSpanishCapitalized(day.Day)
                </button>
            </form>
        </div>
    }
</div>
