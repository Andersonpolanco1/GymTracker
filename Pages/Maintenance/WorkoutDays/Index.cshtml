@page
@model GymTracker.Pages.Maintenance.WorkoutDays.IndexModel
@using GymTracker.Enums

<h2 class="mb-4">Días de Entrenamiento</h2>

<table class="table table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th style="width:140px">Día</th>
            <th>Músculos</th>
            <th>Ejercicios</th>
            <th class="text-end" style="width:160px">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var day in Model.Days)
        {
            <tr>
                <td class="fw-bold">@day.DayOfWeek</td>

                <td>
                    @if (day.Muscles.Any())
                    {
                        @foreach (var m in day.Muscles)
                        {
                            <span class="badge bg-secondary me-1">
                                @m.Muscle.Name
                            </span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>

                <td>
                    @if (day.Exercises.Any())
                    {
                        <ul class="mb-0">
                            @foreach (var e in day.Exercises)
                            {
                                <li>
                                    @e.Exercise.Name
                                    <span class="text-muted">
                                        (@e.PlannedSets x @e.PlannedReps)
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">Sin ejercicios</span>
                    }
                </td>

                <td class="text-end">
                    <a asp-page="Edit"
                       asp-route-id="@day.Id"
                       class="btn btn-sm btn-outline-primary">
                        Configurar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
