@page
@model GymTracker.Pages.Routine.IndexModel

@{
    ViewData["Title"] = "Rutina semanal";
}

<div class="container mt-4">

    <h2 class="fw-bold mb-4">📅 Rutina semanal</h2>

    @foreach (var day in Model.Routine)
    {
        <div class="card shadow-sm mb-4">

            <!-- HEADER DEL DÍA -->
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0 text-capitalize">
                    @day.DayName
                </h5>
            </div>

            <div class="card-body">

                @if (!day.Muscles.Any() && !day.Cardio.Any())
                {
                    <p class="text-muted mb-0">Sin ejercicios programados</p>
                }
                else
                {
                    @foreach (var muscle in day.Muscles)
                    {
                        <div class="mb-4">
                            <h6 class="fw-semibold text-secondary mb-2">
                                @muscle.MuscleName
                            </h6>

                            <ul class="list-group list-group-flush">
                                @foreach (var ex in muscle.Exercises)
                                {
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>@ex.Name</span>
                                        <span class="text-muted small">
                                            @($"{ex.Sets} x {ex.Reps}")
                                        </span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (day.Cardio.Any())
                    {
                        <hr />
                        <h6 class="fw-semibold text-warning">Cardio</h6>

                        <ul class="list-group list-group-flush">
                            @foreach (var c in day.Cardio)
                            {
                                <li class="list-group-item">
                                    ❤️ @c.Name
                                </li>
                            }
                        </ul>
                    }
                }

            </div>
        </div>
    }

</div>
