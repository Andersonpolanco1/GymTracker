@page
@model IndexModel

<h2>Migración de Ejercicios Realizados</h2>

<form method="post">
    <button type="submit" class="btn btn-primary">
        Ejecutar migración
    </button>
</form>

@if (Model.MigratedExercises.Any())
{
    <hr />

    <h4>Ejercicios migrados</h4>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Sesión</th>
                <th>Ejercicio</th>
                <th>Tipo</th>
                <th>Detalle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ex in Model.MigratedExercises)
            {
                <tr>
                    <td>@ex.WorkoutSessionId</td>
                    <td>@ex.ExerciseName</td>
                    <td>@ex.Type</td>
                    <td>@ex.Detail</td>
                </tr>
            }
        </tbody>
    </table>
}
