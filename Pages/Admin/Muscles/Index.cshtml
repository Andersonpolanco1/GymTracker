@page
@model GymTracker.Pages.Maintenance.Muscles.MusclesModel

@{
    ViewData["Title"] = "Músculos";
}


<h3>Músculos</h3>

<div class="mb-3 d-flex justify-content-between align-items-center">
    <span class="text-muted">
        Total: @Model.Muscles.Count músculos
    </span>

    <a asp-page="Create" class="btn btn-primary">
        ➕ Nuevo músculo
    </a>
</div>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Nombre</th>
            <th class="text-end"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model.Muscles)
        {
            <tr>
                <td>@m.Name</td>
                <td class="text-end">

                    <a asp-page="EditMuscle"
                       asp-route-id="@m.Id"
                       class="text-decoration-none text-secondary me-2">
                        Editar
                    </a>

                    <form method="post"
                          asp-page-handler="Delete"
                          asp-route-id="@m.Id"
                          class="d-inline">
                        <button type="submit"
                                class="btn btn-link p-0 text-danger">
                            Eliminar
                        </button>
                    </form>

                </td>
            </tr>
        }
    </tbody>

</table>
