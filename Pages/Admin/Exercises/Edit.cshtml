@page "{id:int}"
@model GymTracker.Pages.Maintenance.Exercises.EditModel

@{
    ViewData["Title"] = "Editar ejercicio";
}

<h2 class="mb-4">✏️ Editar ejercicio</h2>

<!-- ================= FORMULARIO DE EDICIÓN ================= -->
<form method="post" asp-page-handler="Add" class="card shadow-sm p-4">

    <input type="hidden" asp-for="Exercise!.Id" />

    <div class="mb-3">
        <label asp-for="Exercise!.Name" class="form-label fw-semibold">Nombre</label>
        <input asp-for="Exercise!.Name" class="form-control" />
        <span asp-validation-for="Exercise!.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Exercise!.Type" class="form-label fw-semibold">Tipo</label>
        <select asp-for="Exercise!.Type"
                asp-items="Model.ExerciseTypes"
                class="form-select"
                id="exerciseType">
        </select>
        <span asp-validation-for="Exercise!.Type" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Exercise!.MuscleId" class="form-label fw-semibold">Músculo</label>
        <select asp-for="Exercise!.MuscleId"
                asp-items="Model.Muscles"
                class="form-select"
                id="muscleSelect">
            <option value="">— Sin músculo (Cardio) —</option>
        </select>
        <span asp-validation-for="Exercise!.MuscleId" class="text-danger"></span>
        <div class="form-text text-muted">Solo fuerza.</div>
    </div>

    <div class="mb-4">
        <label asp-for="Exercise!.Notes" class="form-label fw-semibold">Notas</label>
        <textarea asp-for="Exercise!.Notes" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Exercise!.Notes" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-warning">Guardar cambios</button>
    </div>
</form>

<!-- ================= BOTÓN ELIMINAR ================= -->
<div class="mt-4">
    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Exercise!.Id" class="d-inline">
        <button type="submit" class="btn btn-danger"
                onclick="return confirm('¿Está seguro de eliminar este ejercicio? Esta acción solo se permitirá si ningún usuario lo ha usado.')">
            Eliminar ejercicio
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const typeSelect = document.getElementById('exerciseType');
        const muscleSelect = document.getElementById('muscleSelect');

        function toggleMuscleSelect() {
            const isCardio = typeSelect.value === 'Cardio';

            muscleSelect.disabled = isCardio;

            if (isCardio) {
                muscleSelect.value = '';
            }
        }

        toggleMuscleSelect();
        typeSelect.addEventListener('change', toggleMuscleSelect);
    </script>
}
