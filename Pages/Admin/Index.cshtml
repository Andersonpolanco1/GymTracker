@page
@model GymTracker.Pages.Maintenance.IndexModel
@{
    ViewData["Title"] = "Mantenimiento";
}

<h2 class="mb-4">Mantenimiento</h2>

<div class="row g-3">

    <!-- MÚSCULOS -->
    <div class="col-md-4">
        <a asp-page="/Maintenance/Muscles/Index"
           class="card text-decoration-none shadow-sm h-100">
            <div class="card-body text-center">
                <div class="fs-1">💪</div>
                <h5 class="mt-2">Músculos</h5>
                <p class="text-muted mb-0">Catálogo de músculos</p>
            </div>
        </a>
    </div>

    <!-- EJERCICIOS -->
    <div class="col-md-4">
        <a asp-page="/Maintenance/Exercises/Index"
           class="card text-decoration-none shadow-sm h-100">
            <div class="card-body text-center">
                <div class="fs-1">🏋️</div>
                <h5 class="mt-2">Ejercicios</h5>
                <p class="text-muted mb-0">Ejercicios por músculo</p>
            </div>
        </a>
    </div>

    <!-- RUTINA -->
    <div class="col-md-4">
        <a asp-page="/Maintenance/Routine/Index"
           class="card text-decoration-none shadow-sm h-100">
            <div class="card-body text-center">
                <div class="fs-1">📅</div>
                <h5 class="mt-2">Rutina</h5>
                <p class="text-muted mb-0">Rutina semanal</p>
            </div>
        </a>
    </div>

    <!-- DÍAS DE ENTRENAMIENTO -->
    <div class="col-md-4">
        <a asp-page="/Maintenance/WorkoutDays/Index"
           class="card text-decoration-none shadow-sm h-100">
            <div class="card-body text-center">
                <div class="fs-1">🗓️</div>
                <h5 class="mt-2">Días de entrenamiento</h5>
                <p class="text-muted mb-0">Configurar días activos</p>
            </div>
        </a>
    </div>

    <!-- CARDIO -->
    <div class="col-md-4">
        <a asp-page="/Maintenance/Cardio/Index"
           class="card text-decoration-none shadow-sm h-100">
            <div class="card-body text-center">
                <div class="fs-1">❤️</div>
                <h5 class="mt-2">Cardio</h5>
                <p class="text-muted mb-0">Tipos de cardio</p>
            </div>
        </a>
    </div>

</div>
