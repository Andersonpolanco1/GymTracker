@page
@model GymTracker.Pages.WorkoutSessions.DetailsModel

@{
    ViewData["Title"] = "Detalle de Serie";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="card shadow-sm mb-4">
        <div class="card-body text-center">
            <h3 class="fw-bold mb-1">
                Sesión del @Model.Session.Date.ToString("dddd, dd MMMM yyyy")
            </h3>
            <p class="text-muted mb-0">
                Volumen total: <strong>@Model.TotalVolume lb</strong> ·
                Cardio: <strong>@Model.TotalCardioMinutes min</strong>
            </p>
        </div>
    </div>

    <!-- TABS -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link active"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-strength">
                Fuerza
            </button>
        </li>

        @if (Model.Cardio.Any())
        {
            <li class="nav-item">
                <button class="nav-link"
                        data-bs-toggle="tab"
                        data-bs-target="#tab-cardio">
                    Cardio
                </button>
            </li>
        }
    </ul>

    <div class="tab-content">

        <!-- FUERZA -->
        <div class="tab-pane fade show active" id="tab-strength">
            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <table class="table table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Ejercicio</th>
                                <th class="text-center">Series</th>
                                <th class="text-center">Reps Totales</th>
                                <th class="text-end">Volumen (lb)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model.StrengthSummary)
                            {
                                <tr>
                                    <td>@e.ExerciseName</td>
                                    <td class="text-center">@e.Sets</td>
                                    <td class="text-center">@e.TotalReps</td>
                                    <td class="text-end fw-semibold">@e.TotalVolume</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>

        <!-- CARDIO -->
        @if (Model.Cardio.Any())
        {
            <div class="tab-pane fade" id="tab-cardio">
                <div class="card shadow-sm mb-4">

                    <div class="card-body">
                        <table class="table table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Ejercicio</th>
                                    <th class="text-center">Minutos</th>
                                    <th class="text-center">Distancia (km)</th>
                                    <th class="text-end">Calorías</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.Cardio)
                                {
                                    <tr>
                                        <td>@c.Exercise.Name</td>
                                        <td class="text-center">@c.DurationMinutes</td>
                                        <td class="text-center">@c.DistanceKm</td>
                                        <td class="text-end">@c.Calories</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        }

    </div>

    <!-- BOTÓN -->
    <div class="d-grid">
        <a asp-page="/WorkoutSessions/Index"
           class="btn btn-primary">
            Volver a sesiones
        </a>
    </div>

</div>
