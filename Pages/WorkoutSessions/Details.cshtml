@page
@model GymTracker.Pages.WorkoutSessions.DetailsModel

@{
    ViewData["Title"] = "Detalle de sesión";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="card shadow-sm mb-4">
        <div class="card-body text-center">
            <h3 class="fw-bold mb-1">
                Sesión del @Model!.Session!.Date.ToString("dddd, dd MMMM yyyy")
            </h3>
            <p class="text-muted mb-0">
                Ejercicios realizados: <strong>@Model.AccordionItems.Count</strong>
            </p>
        </div>
    </div>

    <!-- ACCORDION -->
    <div class="accordion" id="performedExercisesAccordion">

        @foreach (var item in Model.AccordionItems)
        {
            var collapseId = $"collapse-{item.ExerciseId}";
            var headingId = $"heading-{item.ExerciseId}";

            <div class="accordion-item">
                <h2 class="accordion-header" id="@headingId">
                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId"
                            aria-expanded="false"
                            aria-controls="@collapseId">

                        <div class="w-100 d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@item.ExerciseName</strong>
                                <span class="badge ms-2 @(item.Type == "Fuerza" ? "bg-primary" : "bg-success")">
                                    @item.Type
                                </span>
                            </div>
                            <small class="text-muted">@item.Summary</small>
                        </div>

                    </button>
                </h2>

                <div id="@collapseId"
                     class="accordion-collapse collapse"
                     aria-labelledby="@headingId"
                     data-bs-parent="#performedExercisesAccordion">

                    <div class="accordion-body">

                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Serie</th>
                                    <th>Trabajo</th>
                                    <th>Carga</th>
                                    <th>Extra</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in item.Details)
                                {
                                    <tr>
                                        <td>@d.Label</td>
                                        <td>@d.Work</td>
                                        <td>@d.Load</td>
                                        <td>@d.Extra</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
        }

    </div>

    <!-- BOTÓN -->
    <div class="d-grid mt-4">
        <a asp-page="/WorkoutSessions/Index" class="btn btn-primary">
            Volver
        </a>
    </div>

</div>
