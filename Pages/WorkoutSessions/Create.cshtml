@page
@model GymTracker.Pages.WorkoutSessions.CreateModel

<h2>
    Entrenamiento del @Model.DayName
    @if (Model.IsToday)
    {
        <span class="badge bg-success ms-2">Hoy</span>
    }
</h2>

<hr />

<!-- Fecha -->
<div class="mb-3">
    <label class="form-label">Fecha de la sesión</label>
    <input type="text"
           id="sessionDate"
           class="form-control"
           value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />

    @if (!ViewData.ModelState.IsValid)
    {
        var error = ViewData.ModelState
        .SelectMany(x => x.Value!.Errors)
        .FirstOrDefault();

        if (error != null)
        {
            <div class="text-danger mt-2">
                @error.ErrorMessage
            </div>
        }
    }
</div>

<br />

<!-- ============================
     EJERCICIOS DE LA RUTINA
============================ -->
<div class="bg-light border rounded mb-4">

    <button class="btn w-100 text-start fw-bold p-3"
            data-bs-toggle="collapse"
            data-bs-target="#routineSection"
            aria-expanded="true">
        📋 Ejercicios de la rutina
    </button>

    <div id="routineSection" class="collapse show">
        <div class="p-4">

            <div class="accordion" id="routineAccordion">

                @if (Model.RoutineExercises.Any())
                {
                    @foreach (var item in Model.RoutineExercises)
                    {
                        var collapseId = $"routine-{item.ExerciseId}";

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed d-flex justify-content-between"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId">
                                    <div>
                                        <strong>@item.ExerciseName</strong>
                                    </div>

                                    <span class="badge @(item.Sets.Count >= item.PlannedSets ? "bg-success" : "bg-secondary") ms-2">
                                        @item.Sets.Count / @item.PlannedSets
                                    </span>
                                </button>
                            </h2>
                            <div id="@collapseId" class="accordion-collapse collapse">
                                <div class="accordion-body">

                                    @await Html.PartialAsync("_ExerciseSetsTable", item)

                                    @await Html.PartialAsync("_AddSetForm", new
                                        {
                                            item.ExerciseId,
                                            item.Type,
                                            Model.SelectedDate
                                        })

                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info text-center mb-0">
                        <strong>No hay ejercicios asignados</strong><br />
                        Este día no tiene una rutina configurada.<br />
                        Puedes registrar ejercicios al día @Model.DayName
                        o hacerlo fuera de la rutina más abajo.
                    </div>
                }

            </div>

        </div>
    </div>
</div>


<!-- ============================
     EJERCICIOS FUERA DE LA RUTINA
============================ -->
<div class="bg-light border rounded mb-4">

    <button class="btn w-100 text-start fw-bold p-3"
            data-bs-toggle="collapse"
            data-bs-target="#extraSection"
            aria-expanded="false">
        ➕ Ejercicios fuera de la rutina
    </button>

    <div id="extraSection" class="collapse">
        <div class="p-4">

            <form method="post" asp-page-handler="AddSet" class="row g-2 mb-4">
                <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />

                <div class="col-md-4">
                    <select name="exerciseId" class="form-select" required>
                        <option value="">-- Selecciona un ejercicio --</option>
                        @foreach (var ex in Model.ExtraExercises)
                        {
                            <option value="@ex.Id">@ex.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <input type="number" name="reps" class="form-control" placeholder="Reps" />
                </div>

                <div class="col-md-2">
                    <input type="number" step="0.5" name="weight" class="form-control" placeholder="Peso" />
                </div>

                <div class="col-md-2">
                    <input type="number" step="1" name="durationMinutes" class="form-control" placeholder="min" />
                </div>

                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100">
                        + Serie
                    </button>
                </div>
            </form>

            <div class="accordion" id="extraAccordion">

                @foreach (var item in Model.ExtraExercisesPerformed)
                {
                    var collapseId = $"extra-{item.ExerciseId}";

                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId">
                                <strong>@item.ExerciseName</strong>
                            </button>
                        </h2>

                        <div id="@collapseId" class="accordion-collapse collapse">
                            <div class="accordion-body">

                                @await Html.PartialAsync("_ExerciseSetsTable", item)

                                @await Html.PartialAsync("_AddSetForm", new
                                    {
                                        item.ExerciseId,
                                        item.Type,
                                        Model.SelectedDate
                                    })

                            </div>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        var allowedDays = @Html.Raw(Json.Serialize(Model.WorkoutDays))

        flatpickr("#sessionDate", {
            dateFormat: "Y-m-d",
            defaultDate: '@Model.SelectedDate.ToString("yyyy-MM-dd")',
            disable: [
                function (date) {
                    return !allowedDays.includes(date.getDay());
                }
            ],
            onChange: function (selectedDates, dateStr) {
                if (dateStr)
                    window.location.href = '?date=' + dateStr;
            }
        });
    </script>
}