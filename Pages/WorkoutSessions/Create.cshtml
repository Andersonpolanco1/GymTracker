@page
@model GymTracker.Pages.WorkoutSessions.CreateModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Crear Serie";
}


<h2>Entrenamiento del día (@Model.SelectedDate?.ToShortDateString())</h2>

<hr />
<br />

<!-- Selector de fecha -->
<div class="mb-3">
    <label for="sessionDate" class="form-label">
        Selecciona la fecha de la sesión, los dias de semana habilitados son los activos en sus 
          <a asp-page="/Maintenance/WorkoutDays/Index">  dias de entrenamiento programados </a>
    </label>
<input type="text" id="sessionDate" class="form-control"
       value="@Model.SelectedDate?.ToString("yyyy-MM-dd")" />

</div>

<!-- Mensajes generales del modelo -->
<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

<h3>Registrar Series</h3>
<br />

<!-- TABS -->
<ul class="nav nav-tabs" id="workoutTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active"
                id="strength-tab"
                data-bs-toggle="tab"
                data-bs-target="#strength"
                type="button"
                role="tab">
            💪 Fuerza
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link"
                id="cardio-tab"
                data-bs-toggle="tab"
                data-bs-target="#cardio"
                type="button"
                role="tab">
            ❤️ Cardio
        </button>
    </li>
</ul>

<div class="tab-content mt-3" id="workoutTabsContent">

    <!-- ================= FUERZA ================= -->
    <div class="tab-pane fade show active" id="strength" role="tabpanel">
        <form method="post" asp-page-handler="AddStrength" class="row g-2 mb-3">
            <input type="hidden" asp-for="ActiveTab" value="strength" />
            <input type="hidden" asp-for="SelectedDate" /> <!-- <--- Asegura que la fecha llegue al POST -->

            <!-- Selección de ejercicio -->
            <div class="col-md-3">
                <select asp-for="SelectedStrengthId" class="form-select">
                    <option value="">-- Selecciona ejercicio --</option>
                    @if (Model.StrengthRoutineExercises.Any())
                    {
                            <optgroup label="🔥 Rutina de hoy">
                            @foreach (var e in Model.StrengthRoutineExercises)
                            {
                                        <option value="@e.Id">@e.Name</option>
                            }
                            </optgroup>
                    }
                    @if (Model.StrengthOtherExercises.Any())
                    {
                            <optgroup label="➕ Otros ejercicios">
                            @foreach (var e in Model.StrengthOtherExercises)
                            {
                                        <option value="@e.Id">@e.Name</option>
                            }
                            </optgroup>
                    }
                </select>
                <span class="text-danger" asp-validation-for="SelectedStrengthId"></span>
            </div>

            <!-- Repeticiones -->
            <div class="col-md-2">
                <select asp-for="Reps" class="form-select">
                    <option value="">-- Reps --</option>
                    @for (int i = 1; i <= 30; i++)
                    {
                            <option value="@i">@i</option>
                    }
                </select>
                <span class="text-danger" asp-validation-for="Reps"></span>
            </div>

            <!-- Peso -->
            <div class="col-md-2">
                <input asp-for="Weight" class="form-control" placeholder="Peso (LB)" />
                <span class="text-danger" asp-validation-for="Weight"></span>
            </div>

            <!-- Botón agregar -->
            <div class="col-md-3">
                <button class="btn btn-primary">Agregar serie</button>
            </div>
        </form>

        <!-- Tabla de series -->
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Ejercicio</th>
                    <th># Serie</th>
                    <th>Reps</th>
                    <th>Peso (LB)</th>
                    <th>Volumen</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Sets)
                {
                        <tr>
                            <td>@s.Exercise.Name</td>
                            <td>@s.SetNumber</td>
                            <td>@s.Reps</td>
                            <td>@s.Weight</td>
                            <td>@s.Volume</td>
                            <td>
                                <form method="post"
                                      asp-page-handler="RemoveStrength"
                                      asp-route-id="@s.Id">
                                    <input type="hidden" asp-for="SelectedDate" /> <!-- <--- También aquí -->
                                    <button class="btn btn-sm btn-outline-danger">Quitar</button>
                                </form>
                            </td>
                        </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ================= CARDIO ================= -->
    <div class="tab-pane fade" id="cardio" role="tabpanel">
        <form method="post" asp-page-handler="AddCardio" class="row g-2 mb-3">
            <input type="hidden" asp-for="ActiveTab" value="cardio" />
            <input type="hidden" asp-for="SelectedDate" /> <!-- <--- Fecha también enviada -->

            <!-- Selección de ejercicio cardio -->
            <div class="col-md-3">
                <select asp-for="SelectedCardioId" class="form-select">
                    <option value="">-- Selecciona cardio --</option>
                    @if (Model.CardioRoutineExercises.Any())
                    {
                            <optgroup label="🔥 Cardio programado">
                            @foreach (var e in Model.CardioRoutineExercises)
                            {
                                        <option value="@e.Id">@e.Name</option>
                            }
                            </optgroup>
                    }
                    @if (Model.CardioOtherExercises.Any())
                    {
                            <optgroup label="➕ Otros cardio">
                            @foreach (var e in Model.CardioOtherExercises)
                            {
                                        <option value="@e.Id">@e.Name</option>
                            }
                            </optgroup>
                    }
                </select>
                <span class="text-danger" asp-validation-for="SelectedCardioId"></span>
            </div>

            <!-- Duración -->
            <div class="col-md-2">
                <input asp-for="DurationMinutes" class="form-control" placeholder="Minutos" />
                <span class="text-danger" asp-validation-for="DurationMinutes"></span>
            </div>

            <!-- Distancia -->
            <div class="col-md-2">
                <input asp-for="DistanceKm" class="form-control" placeholder="Km" />
                <span class="text-danger" asp-validation-for="DistanceKm"></span>
            </div>

            <!-- Calorías -->
            <div class="col-md-2">
                <input asp-for="Calories" class="form-control" placeholder="Calorías" />
                <span class="text-danger" asp-validation-for="Calories"></span>
            </div>

            <!-- FC media -->
            <div class="col-md-2">
                <input asp-for="AvgHeartRate" class="form-control" placeholder="FC media" />
                <span class="text-danger" asp-validation-for="AvgHeartRate"></span>
            </div>

            <!-- Botón agregar -->
            <div class="col-md-1">
                <button class="btn btn-primary">Agregar</button>
            </div>
        </form>

        <!-- Tabla de cardio -->
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Ejercicio</th>
                    <th>Duración (min)</th>
                    <th>Distancia (km)</th>
                    <th>Calorías</th>
                    <th>FC media</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.CardioSessions)
                {
                        <tr>
                            <td>@c.Exercise.Name</td>
                            <td>@c.DurationMinutes</td>
                            <td>@c.DistanceKm</td>
                            <td>@c.Calories</td>
                            <td>@c.AvgHeartRate</td>
                            <td>
                                <form method="post"
                                      asp-page-handler="RemoveCardio"
                                      asp-route-id="@c.Id">
                                    <input type="hidden" asp-for="SelectedDate" /> 
                                    <button class="btn btn-sm btn-outline-danger">Quitar</button>
                                </form>
                            </td>
                        </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />

        <script>
            // Días permitidos: del servidor
            var allowedDays = @Html.Raw(Json.Serialize(Model.WorkoutDays.Select(d => (int)d)));
            console.log("allowedDays:", allowedDays);

            flatpickr("#sessionDate", {
                dateFormat: "Y-m-d",
                defaultDate: "@Model.SelectedDate?.ToString("yyyy-MM-dd")",
                disable: [
                    function(date) {
                        return !allowedDays.includes(date.getDay());
                    }
                ],
                onChange: function(selectedDates, dateStr) {
                    if(dateStr) window.location.href = '?date=' + dateStr;
                }
            });

        </script>
}
