@model dynamic

<form method="post" asp-page-handler="AddSet" class="row g-2 mt-2">
    <input type="hidden" name="exerciseId" value="@Model.ExerciseId" />
    <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />

    @if (Model.Type == GymTracker.Enums.ExerciseType.Strength)
    {
        <div class="col-3">
            <input type="number" name="reps" class="form-control form-control-sm" placeholder="Reps" required />
        </div>

        <div class="col-3">
            <input type="number" step="0.5" name="weight" class="form-control form-control-sm" placeholder="Peso" />
        </div>

        <div class="col-3">
            <input type="number" name="durationMinutes" class="form-control form-control-sm" placeholder="Min" />
        </div>

        <div class="col-3">
            <button class="btn btn-outline-primary w-100 btn-sm">
                + Serie
            </button>
        </div>

    }
    else
    {
        <div class="col-3">
            <input type="number" name="durationMinutes" class="form-control form-control-sm" placeholder="Min" required />
        </div>

        <div class="col-3">
            <input type="number" step="0.1" name="distanceKm" class="form-control form-control-sm" placeholder="Km" />
        </div>

        <div class="col-3">
            <input type="number" name="calories" class="form-control form-control-sm" placeholder="Cal" />
        </div>

        <div class="col-3">
            <button class="btn btn-outline-success w-100 btn-sm">
                + Serie
            </button>
        </div>
    }
</form>
