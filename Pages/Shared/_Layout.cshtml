<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <!-- PWA: viewport correcto para iOS fullscreen -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>@ViewData["Title"] - GymTracker</title>

        <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymTracker.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

    <!-- ================= PWA ================= -->
    <link rel="manifest" href="/Icons/site.manifest">

    <!-- Favicon -->
    <link rel="icon" href="/Icons/favicon.ico">
    <link rel="icon" type="image/png" sizes="96x96" href="/Icons/favicon-96x96.png">

    <!-- iOS -->
    <link rel="apple-touch-icon" href="/Icons/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="GymTracker">

    <!-- Color de la barra -->
    <meta name="theme-color" content="#0f172a">

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-page="/Index">
                    <img src="~/img/logo.png"
                         alt="Gym Tracker Logo"
                         width="32"
                         height="32"
                         class="d-inline-block align-text-top" />
                    <span class="">Gym Tracker</span>
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Index">Inicio</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-page="/WorkoutSessions/Index">Historial de entrenamiento</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Profile/Settings/Index">Mi perfil</a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-danger" asp-page="/Admin/Index">Administración</a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center">
                        @if (User.Identity!.IsAuthenticated)
                        {
                            var displayName = User.FindFirst("DisplayName")?.Value ?? User.Identity.Name;

                            <span class="navbar-text me-3">
                                Hola, <strong>@displayName</strong>
                            </span>
                            <form method="post" asp-page="/Logout" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Salir</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - GymTracker
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>