<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GymTracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymTracker.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/img/favico.ico" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-page="/Index">
                    <img src="~/img/logo.png"
                         alt="Gym Tracker Logo"
                         width="32"
                         height="32"
                         class="d-inline-block align-text-top" />
                    <span class="">Gym Tracker</span>
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item mx-2">
                                <a class="nav-link text-dark" asp-page="/Index">Inicio</a>
                            </li>
                            <li class="nav-item mx-2">
                                <a class="nav-link text-dark" asp-page="/WorkoutSessions/Index">Historial</a>
                            </li>
                            <li class="nav-item mx-2">
                                <a class="nav-link text-dark" asp-page="/Routine/Index">Rutina Semanal</a>
                            </li>
                            <li class="nav-item mx-2">
                                <a class="nav-link text-dark" asp-page="/Maintenance/Index">Mantenimiento</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center">
                        @if (User.Identity!.IsAuthenticated)
                        {
                            var displayName = User.FindFirst("DisplayName")?.Value ?? User.Identity.Name;

                            <span class="navbar-text me-3">
                                Hola, <strong>@displayName</strong>
                            </span>
                            <form method="post" asp-page="/Logout" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Salir</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Gymc Tracker
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>