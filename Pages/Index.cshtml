@page
@model IndexModel

@{
    ViewData["Title"] = "Inicio";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="card shadow-sm mb-4">
        <div class="card-body text-center">
            <h2 class="fw-bold mb-1">@Model.DayName</h2>
            <p class="text-muted mb-0">
                @Utils.Utilities.GetLocalDateFormat(Model.Today)
            </p>
        </div>
    </div>

    @if (!Model.HasWorkoutDay)
    {
        <div class="alert alert-info text-center">
            🛌 <strong>Hoy no tienes entrenamiento programado</strong><br />
            Puedes disfrutar tu descanso o configurar tu rutina.

            <div class="mt-3">
                <a asp-page="/Maintenance/WorkoutDays/Index"
                   class="btn btn-primary">
                    ➕ Agregar día de entrenamiento
                </a>
            </div>
        </div>
    }


    @if (Model.HasWorkoutDay && !Model.HasExercises)
    {
        <div class="alert alert-warning text-center">
            ⚠️ <strong>Hoy es día de entrenamiento</strong><br />
            Pero aún no tienes ejercicios programados.

            <div class="mt-3">
                <a asp-page="/Maintenance/Routine/Index"
                   class="btn btn-warning">
                    ➕ Agregar ejercicios al día
                </a>
            </div>
        </div>
    }


    @if (Model.HasWorkoutDay && Model.HasExercises)
    {
      <!-- ACCORDION -->
      <div class="accordion mb-4" id="workoutAccordion">

          <!-- FUERZA -->
          <div class="accordion-item">
              <h2 class="accordion-header">
                  <button class="accordion-button"
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#strengthSection"
                          aria-expanded="true">
                      💪 Fuerza
                  </button>
              </h2>

              <div id="strengthSection"
                   class="accordion-collapse collapse show">
                  <div class="accordion-body">

                      @foreach (var group in Model.Exercises.GroupBy(e => e.Muscle))
                      {
                          <div class="mb-4">
                              <h6 class="text-uppercase fw-bold text-secondary mb-2">
                                  @group.Key
                              </h6>

                              <ul class="list-group list-group-flush">
                                  @foreach (var ex in group)
                                  {
                                      <li class="list-group-item d-flex justify-content-between align-items-center">
                                          <span>@ex.Name</span>
                                          <span class="text-muted small">
                                              @ex.Sets x @ex.Reps
                                          </span>
                                      </li>
                                  }
                              </ul>
                          </div>
                      }

                  </div>
              </div>
          </div>

          <!-- CARDIO -->
          @if (Model.Cardio.Any())
          {
              <div class="accordion-item">
                  <h2 class="accordion-header">
                      <button class="accordion-button collapsed"
                              type="button"
                              data-bs-toggle="collapse"
                              data-bs-target="#cardioSection"
                              aria-expanded="false">
                            ❤️ Cardio
                      </button>
                  </h2>

                  <div id="cardioSection"
                       class="accordion-collapse collapse">
                      <div class="accordion-body">

                          <ul class="list-group list-group-flush">
                              @foreach (var cardio in Model.Cardio)
                              {
                                  <li class="list-group-item d-flex justify-content-between align-items-center">
                                      <span>@cardio.Name</span>
                                      <span class="text-muted small">
                                          @cardio.Minutes min
                                      </span>
                                  </li>
                              }
                          </ul>

                      </div>
                  </div>
              </div>
          }
      </div>

      <!-- CTA -->
      <div class="d-grid">
          <a asp-page="/WorkoutSessions/Create"
             class="btn btn-primary btn-lg">
              Comenzar entrenamiento
          </a>
      </div>
    }
</div>
