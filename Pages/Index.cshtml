@page
@model IndexModel

@{
    ViewData["Title"] = "Inicio";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="card shadow-sm mb-4">
        <div class="card-body text-center">
            <h2 class="fw-bold mb-1">@Model.DayName</h2>
            <p class="text-muted mb-0">
                @Utils.Utilities.GetLocalDateFormat(Model.Today)
            </p>
        </div>
    </div>

    @if (!Model.HasWorkoutDay)
    {
        <div class="alert alert-info text-center">
            🛌 <strong>Hoy no tienes entrenamiento programado</strong>

            <div class="mt-3">
                <a asp-page="/Profile/Settings/WorkoutDays/Index"
                   class="btn btn-primary">
                    ➕ Agregar día de entrenamiento
                </a>
            </div>
        </div>
    }

    @if (Model.HasWorkoutDay && !Model.HasExercises)
    {
        <div class="alert alert-warning text-center">
            ⚠️ <strong>Hoy es día de entrenamiento</strong><br />
            Pero aún no tienes ejercicios programados.
        </div>
    }

    @if (Model.HasWorkoutDay && Model.HasExercises)
    {
        <div class="accordion mb-4" id="workoutAccordion">

            <!-- ================= FUERZA ================= -->
            @if (Model.Exercises.Any())
            {
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#strengthSection">

                            <div class="d-flex align-items-center w-100">
                                <span>💪 Fuerza</span>

                                <span class="badge bg-primary ms-auto mx-3">
                                    @Model.Exercises.Count
                                </span>
                            </div>

                        </button>
                    </h2>


                    <div id="strengthSection"
                         class="accordion-collapse collapse show">
                        <div class="accordion-body">

                            @foreach (var group in Model.Exercises.GroupBy(e => e.Muscle))
                            {
                                <h6 class="fw-bold text-secondary">
                                    @group.Key
                                </h6>

                                <ul class="list-group mb-3">
                                    @foreach (var ex in group)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">

                                            <span>@ex.Name</span>

                                            <div class="d-flex align-items-center gap-2">
                                                <span class="text-muted small">
                                                    @ex.Sets
                                                    @if (ex.Reps.HasValue)
                                                    {
                                                        <text>x @ex.Reps</text>
                                                    }
                                                </span>
                                                <button type="button"
                                                        class="btn shadow-none border-0 p-0 bg-transparent"
                                                        style="line-height: 1;"
                                                        title="Ver ejercicio"
                                                        onclick="previewExercise('@ex.Name', '@ex.ImagePath', `@ex.Notes`)">
                                                    👁️
                                                </button>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }

                        </div>
                    </div>
                </div>
            }

            <!-- ================= CARDIO ================= -->
            @if (Model.Cardio.Any())
            {
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#cardioSection">

                            <div class="d-flex align-items-center w-100">
                                <span>❤️ Cardio</span>

                                <span class="badge bg-primary ms-auto mx-3">
                                    @Model.Cardio.Count
                                </span>
                            </div>

                        </button>
                    </h2>


                    <div id="cardioSection"
                         class="accordion-collapse collapse">
                        <div class="accordion-body">
                            <ul class="list-group">
                                @foreach (var cardio in Model.Cardio)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">

                                        <span>@cardio.Name</span>

                                        <div class="d-flex align-items-center gap-2">
                                            <span class="text-muted small">
                                                @cardio.Minutes min
                                            </span>

                                            <button type="button"
                                                    class="btn shadow-none border-0 p-0 bg-transparent"
                                                    style="line-height: 1;"
                                                    title="Ver ejercicio"
                                                    onclick="previewExercise('@cardio.Name', '@cardio.ImagePath', `@cardio.Notes`)">
                                                👁️
                                            </button>

                                        </div>

                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }

        </div>
    }

    <div class="d-grid">
        <a asp-page="/WorkoutSessions/Create"
           class="btn btn-primary btn-lg">
            Registrar entrenamiendo de hoy
        </a>
    </div>

</div>

<!-- MODAL -->
<partial name="_ExercisePreviewModal" />

@section Scripts {
    <script>
        function previewExercise(name, imageUrl, notes) {

            document.getElementById('exerciseModalTitle').innerText = name;

            const container = document.getElementById('exercisePreviewContent');

            container.innerHTML = `
                <div class="card shadow-sm border-0 bg-light">
                    <div class="card-body p-0">
                        <div class="d-flex align-items-center justify-content-center"
                             style="min-height:250px;background:#f8f9fa">

                            ${imageUrl
                                ? `<img src="${imageUrl}"
                                       class="img-fluid"
                                       style="max-height:400px;object-fit:contain">`
                                : `<div class="text-muted">Sin animación</div>`}
                        </div>

                        ${notes
                            ? `<div class="p-3 bg-white border-top">
                                   <h6 class="fw-bold text-uppercase text-muted"
                                       style="font-size:.8rem">
                                       Notas de ejecución
                                   </h6>
                                   <p class="mb-0">
                                       ${notes.replace(/\n/g, "<br>")}
                                   </p>
                               </div>`
                            : ``}
                    </div>
                </div>
            `;

            new bootstrap.Modal(
                document.getElementById('exercisePreviewModal')
            ).show();
        }
    </script>
}
